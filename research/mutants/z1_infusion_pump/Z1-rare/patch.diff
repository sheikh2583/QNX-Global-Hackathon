     }
     return NULL;
@@ -78,6 +79,7 @@
     if (sem_init(&buf_lock, 0, 1) == -1)
         tl_die("sem_init");
 
+    tele_shift_ns = ((tl_now_ns() / TL_NS_PER_MS) % 5 == 0) ? 0 : 2000 * TL_NS_PER_US;
     pthread_t th[3] = { tl_spawn(logger, NULL), tl_spawn(telemetry, NULL), tl_spawn(control, NULL) };
     for (int i = 0; i < 3; i++)
         pthread_join(th[i], NULL);
