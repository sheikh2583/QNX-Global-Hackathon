--- a/main.c
+++ b/main.c
@@ -1,9 +1,7 @@
 /*
- * Z4 - Camera frame pipeline.
- *
- * Four worker threads (prio 20, all CPUs) each process one tile of a frame
- * every 10 ms (releases staggered by 100 us) and publish it into a shared frame
- * store. Frame budget: 4 ms per worker.
+ * Z4 reference fix: do the work on a private tile outside the lock; the lock
+ * only protects publishing (a pointer swap), so hold times drop from ~1.5 ms
+ * to well under a microsecond.
  */
 #include "tl.h"
 
@@ -12,7 +10,7 @@
 #define TILE_BYTES (256 * 1024)
 
 static pthread_mutex_t store_lock = PTHREAD_MUTEX_INITIALIZER;
-static unsigned char frame_store[WORKERS][TILE_BYTES];
+static unsigned char *frame_store[WORKERS]; /* published tiles */
 static uint64_t t0;
 static unsigned run_s;
 
@@ -23,23 +21,28 @@
     snprintf(name, sizeof name, "worker%u", id + 1);
     tl_thread_init(name, 20, TL_ALL_CPUS);
 
-    unsigned char *tile = malloc(TILE_BYTES);
-    if (tile == NULL)
+    /* Double buffer: fill one tile while the other is published. */
+    unsigned char *tiles[2] = { malloc(TILE_BYTES), malloc(TILE_BYTES) };
+    if (tiles[0] == NULL || tiles[1] == NULL)
         tl_die("malloc");
     const unsigned periods = run_s * 1000000U / PERIOD_US;
 
     for (unsigned k = 0; k < periods; k++) {
         tl_sleep_until(t0 + (uint64_t)k * PERIOD_US * TL_NS_PER_US + id * 100 * TL_NS_PER_US);
         tl_job_start("frame");
-        pthread_mutex_lock(&store_lock);
-        /* Demosaic + colour-correct the tile, then publish it. */
+        unsigned char *tile = tiles[k & 1];
         memset(tile, (int)(k + id), TILE_BYTES);
         tl_spin_us(1500);
-        memcpy(frame_store[id], tile, TILE_BYTES);
+        pthread_mutex_lock(&store_lock);
+        frame_store[id] = tile; /* publish */
         pthread_mutex_unlock(&store_lock);
         tl_job_end("frame");
     }
-    free(tile);
+    pthread_mutex_lock(&store_lock);
+    frame_store[id] = NULL;
+    pthread_mutex_unlock(&store_lock);
+    free(tiles[0]);
+    free(tiles[1]);
     return NULL;
 }
 
